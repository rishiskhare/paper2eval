+    static void push(std::vector<Line> &out, const Line &l) {
+        if (out.empty() || out.back().a != l.a || out.back().b != l.b)
+            out.push_back(l);
+    }
+
+    // Keep the part of `in` with ca*a + cb*b <= c.
+    static void clip(const std::vector<Line> &in, long double ca, long double cb, long double c, std::vector<Line> &out) {
+        out.clear();
+        for (size_t i = 0, m = in.size(); i < m; ++i) {
+            const Line &p = in[i], &q = in[(i + 1) % m];
+            long double sp = ca * p.a + cb * p.b - c, sq = ca * q.a + cb * q.b - c;
+            if (sp <= 0)
+                push(out, p);
+            if ((sp < 0 && sq > 0) || (sp > 0 && sq < 0)) {
+                long double t = sp / (sp - sq);
+                push(out, {p.a + t * (q.a - p.a), p.b + t * (q.b - p.b)});
+            }
+        }
+        if (out.size() > 1 && out.front().a == out.back().a && out.front().b == out.back().b)
+            out.pop_back();
+    }
 
